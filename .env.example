# Firefly AI Hub — environment / secrets reference
# Real values live in /etc/ai-hub/hub.env (chmod 600), loaded by docker-compose.
# This file documents the variables; it holds NO real values and is gitignored-safe.

# --- Existing hub secrets ---
DISCORD_TOKEN=
GMAIL_APP_PASSWORD=
# Shared X-Auth secret for the web tools HTTP API on :8787 (Open WebUI hub_web_tools.py)
MEMORY_API_TOKEN=

# --- F0: LiteLLM gateway ---
# Master key for the LiteLLM gateway on :4000. Generate a strong value.
LITELLM_MASTER_KEY=sk-generate-a-strong-one
# Cloud fallback key for the `frontier` model. Intentionally LEFT BLANK for now —
# the frontier fallback is not wired in yet. Set this and uncomment the fallback
# in litellm-config.yaml to enable it.
ANTHROPIC_API_KEY=

# --- F1: Postgres sync service ---
# Reuses the Temporal Postgres instance; the sync service creates/uses the
# firefly_sync database itself on boot.
SYNC_DB_URL=postgres://temporal:temporal@postgresql:5432/firefly_sync
# Bearer token (X-Auth) for the sync API on :8788.
SYNC_API_TOKEN=

# --- F2: Vector store + embeddings ---
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://host.docker.internal:11434
