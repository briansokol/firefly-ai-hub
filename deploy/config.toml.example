[discord]
token_env        = "DISCORD_TOKEN"
allowed_user_ids = ["YOUR_DISCORD_USER_ID"]
guild_id         = "YOUR_GUILD_ID"

[models]
default         = "qwen3.6:27b-q4_k_m"
coding          = "qwen3-coder:30b"
complex         = "qwen3.6:27b-q4_k_m"
ollama_base_url = "http://host.docker.internal:11434/v1"

[schedule]
timezone           = "America/New_York"
email_triage_cron  = "0 7 * * *"
daily_summary_cron = "0 21 * * *"

[[email.accounts]]
name         = "gmail"
host         = "imap.gmail.com"
port         = 993
username     = "you@gmail.com"
password_env = "GMAIL_APP_PASSWORD"
ssl          = true
folders      = ["INBOX"]

[email.categorization]
enabled          = true
source_folder    = "Screening"
categories       = ["Alerts", "Bills", "Development", "Newsletters", "Orders", "Other", "Shipping", "VIP"]
default_category = "Other"
batch_size       = 10
# model          = ""  # empty = use models.default

# [tools.web_search]
# provider    = "brave"
# api_key_env = "BRAVE_SEARCH_API_KEY"

# [tools.weather]
# default_location = "New York"

